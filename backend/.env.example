PORT=4000
# Free key: https://aistudio.google.com/apikey  (leave empty => mock brain)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Free tier token: https://console.apify.com/settings/integrations (leave empty => mock collectors)
